    ja {
      cityMissing: "都市が見つかりません"; cityNeeded: "都市を入力してください"
      refresh: "更新"; title: "天気"; loading: "天気…"; offline: "天気を取得できません"; city: "都市 · 空欄 = 自動"; here: "現在地を使う"
      feels: "体感"; humidity: "湿度"; rainToday: "今日の降水"; uv: "UV 指数"; pressure: "気圧"
