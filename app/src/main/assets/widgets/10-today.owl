  source now = clock every 1m
  // The date on two lines with the forecast row under it needs about 195dp; a 3x3 squeezed by an extra row
  // (190 on a Pixel 9a) cut the forecast off.
  let short = tileHeight != null && tileHeight < 200
  // A low tile (two rows on a phone) has no room for the days ahead; a narrow one (two columns) drops sunrise and sunset.
  let low = tileHeight != null && tileHeight < 150
  let narrow = tileWidth != null && tileWidth < 170
  state city = "" persist
  state unitChoice = "" persist
  state cityMatch = null persist
  state lastMeteo = null persist
  source here = android.location
  source cityLookup = http(city == "" ? null : "https://geocoding-api.open-meteo.com/v1/search?name=${enc(city)}&count=1&language=${enc(lang())}") every 24h timeout 10s json status
  on cityLookup first {
    if value.ok {
      cityMatch = {query: city, place: value.out.results[0]}
    }
  }
  // Preserve automatic weather by IP when Android has no location fix.
  source byIp = http(city == "" && here != null && !here.available ? "https://ipwho.is/?fields=success,city,country,country_code,latitude,longitude" : null) every 6h timeout 10s json status
  let place = city != "" ? (cityMatch.query == city ? cityMatch.place : null) :
              here.available ? {name: str.here, latitude: here.lat, longitude: here.lon} :
              byIp.out.success ? {name: byIp.out.city, country: byIp.out.country, country_code: byIp.out.country_code,
                                  latitude: byIp.out.latitude, longitude: byIp.out.longitude} :
              lastMeteo.city == "" ? lastMeteo.place : null
  let locationKey = place.latitude == null || place.longitude == null ? null : "${fixed(place.latitude, 2)},${fixed(place.longitude, 2)}"
  source forecast = http(locationKey == null ? null : "https://api.open-meteo.com/v1/forecast?latitude=${fixed(place.latitude, 2)}&longitude=${fixed(place.longitude, 2)}&current=temperature_2m,apparent_temperature,weather_code,is_day,relative_humidity_2m,pressure_msl,wind_speed_10m,wind_direction_10m&hourly=temperature_2m,weather_code,is_day,precipitation_probability,visibility&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,uv_index_max,sunrise,sunset&timezone=auto&forecast_days=3") every 30m timeout 12s json status
  on forecast first {
    if value.ok && value.out.current.temperature_2m != null {
      lastMeteo = {location: locationKey, data: value.out, at: now, place: place, city: city}
    }
  }
  let wx = locationKey != null && lastMeteo.location == locationKey ? lastMeteo.data : null
  let failed = locationKey != null && forecast != null && (!forecast.ok || forecast.out.current.temperature_2m == null)
  let cityMissing = city != "" && cityMatch.query == city && cityMatch.place == null
  let placeLookup = city == "" ? byIp : cityLookup
  let weatherStatus = cityMissing ? str.cityMissing :
                      locationKey == null && placeLookup != null ? str.cityNeeded :
                      failed ? str.offline : str.loading
  let cur = wx.current
  let imperial = unitChoice == "F" || (unitChoice == "" && contains(["US", "LR", "MM"], place.country_code))
  let unit = imperial ? "F" : "C"
  let tempFactor = imperial ? 1.8 : 1
  let tempOffset = imperial ? 32 : 0
  let temperature = round(cur.temperature_2m * tempFactor + tempOffset)
  let feels = round(cur.apparent_temperature * tempFactor + tempOffset)
  let placeName = place.name ?? city
  // WMO weather interpretation codes mapped to the launcher's existing icons and translations.
  let conditions = {
    "0": ["113", "clear"], "1": ["116", "mainly clear"], "2": ["116", "partly cloudy"], "3": ["122", "overcast"],
    "45": ["248", "fog"], "48": ["260", "freezing fog"],
    "51": ["263", "light drizzle"], "53": ["266", "drizzle"], "55": ["266", "heavy drizzle"],
    "56": ["281", "freezing drizzle"], "57": ["284", "heavy freezing drizzle"],
    "61": ["296", "light rain"], "63": ["302", "rain"], "65": ["308", "heavy rain"],
    "66": ["311", "freezing rain"], "67": ["314", "heavy freezing rain"],
    "71": ["326", "light snow"], "73": ["332", "snow"], "75": ["338", "heavy snow"], "77": ["350", "snow grains"],
    "80": ["353", "light showers"], "81": ["356", "showers"], "82": ["359", "heavy showers"],
    "85": ["368", "light snow showers"], "86": ["371", "heavy snow showers"],
    "95": ["389", "thunderstorm"], "96": ["392", "thunderstorm with hail"], "99": ["395", "heavy thunderstorm with hail"]
  }
  let curSky = get(conditions, str(cur.weather_code), [null, "—"])
  let night = cur.is_day == 0
  let sky = contains(["113", "116"], curSky[0]) ? (night ? blue : yellow) : foreground
  let compass = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
  let wind = compass[round(cur.wind_direction_10m / 22.5) % 16]
  let days = range(len(wx.daily.time)).map(i => {
    date: wx.daily.time[i], code: conditions[str(wx.daily.weather_code[i])][0],
    lo: round(wx.daily.temperature_2m_min[i] * tempFactor + tempOffset), hi: round(wx.daily.temperature_2m_max[i] * tempFactor + tempOffset),
    rain: wx.daily.precipitation_probability_max[i], precipitation: wx.daily.precipitation_sum[i],
    sunUp: sub(wx.daily.sunrise[i], 11, 16), sunDown: sub(wx.daily.sunset[i], 11, 16), uv: wx.daily.uv_index_max[i]
  })
  let day = days[0]
  let hourNow = fmtTime(now, "yyyy-MM-dd'T'HH':00'", wx.timezone)
  let hourIndex = max(0, indexOf(wx.hourly.time ?? [], hourNow))
  let steps = range(len(wx.hourly.time)).drop(hourIndex).filter(i => (i - hourIndex) % 3 == 0).take(8).map(i => {
    timestamp: wx.hourly.time[i], t: round(wx.hourly.temperature_2m[i] * tempFactor + tempOffset), rain: wx.hourly.precipitation_probability[i],
    code: conditions[str(wx.hourly.weather_code[i])][0], night: wx.hourly.is_day[i] == 0
  })
  let lowest = min(days.map(d => d.lo))
  let highest = max(days.map(d => d.hi))
  let uv = day.uv
  let visibility = wx.hourly.visibility[hourIndex]
  // Approximate phase from the known new moon of January 2000 and the mean synodic month.
  let lunarAge = (now - parseTime("2000-01-06T18:14:00Z")) / (29.53059 * 86400)
  let moonIndex = round((lunarAge - floor(lunarAge)) * 8) % 8
  let moonLit = round(50 * (1 - cos(lunarAge * 2 * pi)))
  let moonName = ["New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous",
                  "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"][moonIndex]
  let moonIcon = ["", "", "", "", "", "", "", ""][moonIndex]

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Stat(glyph, label, value, tint = foreground) {
    Row {
      gap: 10
      align: center
      padding: [10, 8]
      border: 1
      borderColor: alpha(muted, 0.3)
      Text { text: glyph; font: icon; fontSize: 22; color: tint; width: 28; align: center }
      Column {
        gap: 0
        weight: 1
        Text { text: label; style: label; color: muted; maxLines: 1 }
        Text { text: value; style: body; maxLines: 1 }
      }
    }
  }

  Column {
    gap: 0
    // A short tile (a 3x3 on the landscape home screen) gets the date on one line, so the forecast row still fits,
    // and so does a narrow one, where the month won't fit beside the big day.
    if short || narrow {
      Row {
        gap: 6
        align: center
        Text { text: fmtTime(now, "d"); fontSize: 20; width: 28; maxLines: 1 }
        Text { text: lower(fmtTime(now, "EEEE")); style: label; color: accent; weight: 1; maxLines: 1 }
        if !narrow {
          Text { text: lower(fmtTime(now, "MMMM")); style: small; color: muted; width: 76; align: end; maxLines: 1 }
        }
      }
    } else {
      Row {
        gap: 10
        align: center
        Text { text: fmtTime(now, "d"); style: huge; width: 60 }
        Column {
          gap: 0
          weight: 1
          Text { text: lower(fmtTime(now, "EEEE")); style: label; color: accent; maxLines: 1 }
          Text { text: lower(fmtTime(now, str.monthYear)); style: small; color: muted; maxLines: 1 }
        }
      }
    }
    Spacer { weight: 1 }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    Spacer { height: 8 }
    if cur != null {
      Row {
        gap: 6
        align: bottom
        Text { text: weatherIcon(curSky[0], night); font: icon; fontSize: 32; color: sky; width: 26; padding: [0, 0, 0, 3] }
        Text { text: "${temperature}°"; fontSize: 28; color: failed ? muted : cyan; width: 68; maxLines: 1 }
        if !narrow {
          Column {
            gap: 0
            weight: 1
            Text { text: str.sky(curSky[0], curSky[1]); style: small; align: end; maxLines: 1 }
            Text { text: "↑${day.hi}° ↓${day.lo}°"; style: small; color: muted; align: end; maxLines: 1; padding: [0, 0, 0, 5] }
          }
        }
      }
      Text { text: "${str.feels} ${feels}° · ${placeName}"; style: small; color: muted; maxLines: 1 }
      if !low {
        Spacer { weight: 1 }
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Spacer { height: 8 }
        // The next two days, then sunrise and sunset.
        // Each named from its own date: just after midnight, the forecast from before it still starts yesterday.
        Row {
          gap: 4
          align: center
          for d, i in days.drop(1) key d.date {
            Column {
              gap: 0
              weight: 1
              align: center
              Text { text: lower(fmtTime(parseTime(d.date), "EEE")); style: label; color: muted; align: center }
              Text { text: weatherIcon(d.code, false); font: icon; fontSize: 18; align: center }
              Text { text: "${d.hi}° ${d.lo}°"; style: small; align: center; maxLines: 1 }
            }
          }
          if !narrow {
            Column {
              gap: 4
              weight: 1.2
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: yellow; width: 20 }
                Text { text: day.sunUp; style: small; maxLines: 1; weight: 1 }
              }
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: orange; width: 20 }
                Text { text: day.sunDown; style: small; maxLines: 1; weight: 1 }
              }
            }
          }
        }
      }
    } else {
      Text { text: weatherStatus; style: small; color: muted }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    // The tile requests Android location permission only from this button.
    if here != null && !here.granted {
      Text { text: str.here; style: body; color: accent; maxLines: 1; padding: [0, 6]; onTap: location("request") }
    }
    if failed || cur == null {
      Column {
        gap: 4
        if failed {
          Text { text: forecast.code > 0 ? "Open-Meteo · HTTP ${forecast.code}" : forecast.err; style: small; maxLines: 2; color: muted }
          if wx != null && lastMeteo.at != null {
            Text { text: "${fmtTime(lastMeteo.at, "dd.MM HH:mm")}"; style: small; color: muted }
          }
        }
        Button { text: str.refresh; onTap: refresh() }
      }
    }
    if cur == null {
      Text { text: weatherStatus; style: body; color: muted }
    } else {
      Column {
        scroll: true
        onPull: refresh()
        gap: 14
        // Now.
        Row {
          gap: 16
          align: center
          Text { text: weatherIcon(curSky[0], night); font: icon; fontSize: 64; color: sky; width: 80; align: center }
          Column {
            gap: 0
            weight: 1
            Text {
              text: "${temperature}°${unit}"
              fontSize: 44
              color: cyan
              maxLines: 1
              onTap: unitChoice = unit == "C" ? "F" : "C"
            }
            Text { text: str.sky(curSky[0], curSky[1]); style: body; maxLines: 2 }
          }
        }
        Text {
          text: "${str.feels} ${feels}° · ↑${day.hi}° ↓${day.lo}° · ${placeName}${place.country == null ? "" : ", " + place.country}"
          style: small
          color: muted
        }
        Rule { }
        Grid {
          columns: 2
          gap: 8
          Stat { glyph: ""; label: str.wind(wind); value: imperial ? "${round(cur.wind_speed_10m / 1.609344)} mph" : "${round(cur.wind_speed_10m)} ${str.kmh}"; tint: cyan }
          Stat { glyph: ""; label: str.humidity; value: "${cur.relative_humidity_2m}%"; tint: blue }
          Stat { glyph: ""; label: str.rainToday; value: "${day.rain}% · ${imperial ? fixed(day.precipitation / 25.4, 2) + " in" : day.precipitation + " mm"}"; tint: blue }
          Stat { glyph: ""; label: str.uv; value: "${uv} ${str.uvLevel(uv)}"; tint: uv >= 6 ? red : uv >= 3 ? yellow : green }
          Stat { glyph: ""; label: str.pressure; value: imperial ? "${fixed(cur.pressure_msl / 33.8639, 1)} inHg" : "${round(cur.pressure_msl)} hPa" }
          Stat { glyph: ""; label: str.visibility; value: visibility == null ? "—" : imperial ? "${fixed(visibility / 1609.344, 1)} mi" : "${fixed(visibility / 1000, 1)} km" }
        }
        Rule { }
        // The next 24 hours: time, icon and rain chance per step, with the temperature curve under them.
        Text { text: str.next24; style: label; color: accent }
        Column {
          gap: 4
          Row {
            gap: 0
            for s, i in steps key s.timestamp {
              Column {
                gap: 2
                weight: 1
                align: center
                Text { text: i == 0 ? str.now : sub(s.timestamp, 11, 13); style: label; color: muted; align: center }
                Text { text: weatherIcon(s.code, s.night); font: icon; fontSize: 20; align: center }
              }
            }
          }
          Canvas {
            height: 84
            fill: width
            let n = max(len(steps), 1)
            let temps = steps.map(s => s.t)
            let lo = min(temps)
            let hi = max(temps)
            let ys = temps.map(t => 22 + (hi - t) / max(hi - lo, 1) * 26)
            let xs = range(n).map(i => (i + 0.5) * width / n)
            path(range(n).map(i => [xs[i], ys[i]]), stroke: accent, width: 2)
            for s, i in steps {
              circle(xs[i], ys[i], 3, fill: accent)
              text("${s.t}°", xs[i], ys[i] - 13, size: 12, align: center, color: foreground)
              rect(xs[i] - 10, height - 12, 20, 4, radius: 2, fill: alpha(muted, 0.2))
              rect(xs[i] - 10, height - 12, 20 * s.rain / 100, 4, radius: 2, fill: blue)
              text("${s.rain}%", xs[i], height - 24, size: 10, align: center, color: s.rain >= 30 ? blue : muted)
            }
          }
        }
        Rule { }
        // Three days: icon, rain chance and the day's low to high on a shared scale.
        Text { text: str.days; style: label; color: accent }
        for d in days key d.date {
          let lo = num(d.lo)
          let hi = num(d.hi)
          Row {
            gap: 8
            align: center
            Text { text: d.date == fmtTime(now, "yyyy-MM-dd", wx.timezone) ? str.today : lower(fmtTime(parseTime(d.date), "EEE")); style: body; width: 64; maxLines: 1 }
            Text { text: weatherIcon(d.code, false); font: icon; fontSize: 20; width: 26; align: center }
            Text { text: "${d.rain}%"; style: small; color: blue; width: 40; align: end; maxLines: 1 }
            Text { text: "${lo}°"; style: small; color: muted; width: 36; align: end; maxLines: 1 }
            Canvas {
              height: 6
              weight: 1
              let span = max(highest - lowest, 1)
              let x0 = (lo - lowest) / span * width
              let x1 = (hi - lowest) / span * width
              rect(0, 0, width, height, radius: 3, fill: alpha(muted, 0.2))
              rect(x0, 0, max(x1 - x0, 6), height, radius: 3, fill: linear(0, 0, width, 0, [cyan, orange]))
            }
            Text { text: "${hi}°"; style: small; width: 36; maxLines: 1 }
          }
        }
        Rule { }
        // Sun in the forecast location’s time zone and the current Moon phase.
        Row {
          gap: 8
          Stat { glyph: ""; label: str.sunrise; value: day.sunUp; tint: yellow; weight: 1 }
          Stat { glyph: ""; label: str.sunset; value: day.sunDown; tint: orange; weight: 1 }
        }
        Stat { glyph: moonIcon; label: str.moon; value: str.phase(moonName, moonLit) }
        Row {
          justify: end
          Button { text: "Open-Meteo ↗"; color: muted; onTap: url("https://open-meteo.com/") }
        }
      }
    }
  }
}
