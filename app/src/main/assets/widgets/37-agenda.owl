widget "agenda" {
  page: 2
  order: 3
  size: 2x2
  minSize: 2x2
  meta { owl: 18; description: "Today's date offline and the upcoming events of the Android calendar." }

  strings {
    en { title: "calendar"; allow: "allow access"; empty: "no events in the next 14 days"; pattern: "EEE d MMM"; details: "upcoming events" }
    ru { title: "календарь"; allow: "дать доступ"; empty: "нет событий на 14 дней"; pattern: "EEE d MMM"; details: "ближайшие события" }
  }

  onTap: screen()

  source now = clock every 1m
  source agenda = android.calendar

  Column {
    fill: true
    justify: spaceBetween
    gap: 4
    Text { text: str.title; style: muted; maxLines: 1 }
    Row {
      align: center
      gap: 7
      Text { text: fmtTime(now, "d"); style: huge; color: accent; maxLines: 1 }
      Column {
        weight: 1
        gap: 1
        Text { text: fmtTime(now, "EEEE"); style: small; maxLines: 1 }
        Text { text: fmtTime(now, "MMMM"); style: label; maxLines: 1 }
      }
    }
    if agenda != null && !agenda.granted {
      Button { text: str.allow; onTap: calendar("request") }
    } else {
      let next = agenda.events[0]
      Text { text: agenda == null ? "…" : next == null ? str.empty : next.title; style: small; maxLines: 2 }
    }
  }

  screen {
    title: str.details
    if agenda != null && !agenda.granted {
      Button { text: str.allow; onTap: calendar("request") }
    } else {
      Column {
        gap: 8
        scroll: true
        if agenda != null && len(agenda.events) == 0 {
          Text { text: str.empty; style: small }
        }
        for event in agenda.events key event.id {
          Column {
            gap: 2
            onTap: calendar("open", event)
            Text { text: fmtTime(event.start, str.pattern + (event.allDay ? "" : " HH:mm")); style: small; color: muted }
            Text { text: event.title; maxLines: 2 }
          }
        }
      }
    }
  }
}
