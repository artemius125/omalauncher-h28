widget "device-status" {
  page: 2
  order: 2
  size: 1x1
  minSize: 1x1
  meta { owl: 29; description: "Check the reachability of three local devices once a minute." }

  strings {
    en { title: "devices"; computer: "Computer"; online: "online"; offline: "no reply"; pending: "—"; ip: "local IP" }
    ru { title: "устройства"; computer: "Компьютер"; online: "в сети"; offline: "нет ответа"; pending: "—"; ip: "локальный IP" }
  }

  onTap: screen()

  state miniIp = "" persist
  state imacIp = "" persist
  state computerIp = "" persist
  source mini = ping(miniIp == "" ? null : miniIp) every 1m
  source imac = ping(imacIp == "" ? null : imacIp) every 1m
  source computer = ping(computerIp == "" ? null : computerIp) every 1m

  component Device(name, address, result, detail) {
    let known = address != "" && result.address == address
    let color = !known ? muted : result.online ? green : red
    Row {
      gap: 5
      align: center
      Text { text: known ? "●" : "○"; color: color; fontSize: 8; maxLines: 1 }
      Text { text: name; weight: 1; fontSize: detail ? 16 : 10; maxLines: 1 }
      if detail {
        Text { text: !known ? str.pending : result.online ? str.online : str.offline; color: color; style: small; maxLines: 1 }
      }
    }
  }

  Column {
    fill: true
    justify: spaceEvenly
    gap: 2
    Device { name: "Mac mini"; address: miniIp; result: mini; detail: false }
    Device { name: "iMac"; address: imacIp; result: imac; detail: false }
    Device { name: str.computer; address: computerIp; result: computer; detail: false }
  }

  screen {
    title: str.title
    Column {
      gap: 10
      scroll: true
      Device { name: "Mac mini"; address: miniIp; result: mini; detail: true }
      Input { text: miniIp; placeholder: str.ip; onSubmit: miniIp = trim(value) }
      Device { name: "iMac"; address: imacIp; result: imac; detail: true }
      Input { text: imacIp; placeholder: str.ip; onSubmit: imacIp = trim(value) }
      Device { name: str.computer; address: computerIp; result: computer; detail: true }
      Input { text: computerIp; placeholder: str.ip; onSubmit: computerIp = trim(value) }
    }
  }
}
