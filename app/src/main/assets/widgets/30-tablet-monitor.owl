widget "tablet-monitor" {
  page: 2
  order: 1
  size: 3x3
  minSize: 2x2
  meta { owl: 29; description: "Six live charts for CPU, memory, network, tablet thermal state and battery power." }

  strings {
    en {
      title: "tablet history"; memory: "RAM"; rx: "↓ RX"; tx: "↑ TX"; network: "network"; battery: "battery"; hours: "−3 h"; twoHours: "−2 h"; oneHour: "−1 h"; now: "now"; temp: "CPU °C"; heat: "heat"
      draw: "draw"; charge: "charge"; power: "battery W"; files: "OWL files"
      cpuScope: "CPU · launcher and its Linux processes"; noCpu: "CPU history needs Linux running"
      noTemp: "The tablet exposes thermal status to OMA. CPU degrees are unavailable."
      stages: ["normal", "light", "moderate", "severe", "critical", "emergency", "shutdown"]
      batteryWindow: "battery · last 3 hours"; batteryWaiting: "History is collecting"; percentagePoints: "pp"
      samples: n => "${n} samples · every 5 s while monitoring"; range: "range"; mean: "average"
      wattsNote: "Battery power for the whole tablet."
    }
    ru {
      title: "история планшета"; memory: "ОЗУ"; rx: "↓ приём"; tx: "↑ отправка"; network: "сеть"; battery: "батарея"; hours: "−3 ч"; twoHours: "−2 ч"; oneHour: "−1 ч"; now: "сейчас"; temp: "ЦП °C"; heat: "нагрев"
      draw: "расход"; charge: "заряд"; power: "питание"; files: "файлы OWL"
      cpuScope: "ЦП · лаунчер и его Linux-процессы"; noCpu: "Для истории ЦП запусти Linux"
      noTemp: "Планшет передаёт OMA уровень нагрева. Градусы ЦП недоступны."
      stages: ["норма", "лёгкий", "средний", "сильный", "критический", "авария", "выключение"]
      batteryWindow: "батарея · последние 3 часа"; batteryWaiting: "История накапливается"; percentagePoints: "п. п."
      samples: n => "${n} замеров · раз в 5 с во время мониторинга"; range: "диапазон"; mean: "среднее"
      wattsNote: "Мощность на аккумуляторе всего планшета."
    }
  }

  onTap: screen()

  source power = android.power every 5s
  source battery = android.battery
  source batteryClock = clock every 1m
  source chargeHistory = android.batteryHistory every 1m
  source system = android.system every 5s
  source net = android.network every 5s
  source cpu = cmd("head -n 1 /proc/stat") every 5s optional
  source thermal = android.thermal every 10s
  source clockSample = clock every 5s
  state samples = []
  state down = null
  state up = null
  state usage = null

  on net {
    let seconds = value.uptime - old.uptime
    down = old.rx != null && value.rx != null && value.rx >= old.rx && seconds > 0 ? (value.rx - old.rx) / seconds : null
    up = old.tx != null && value.tx != null && value.tx >= old.tx && seconds > 0 ? (value.tx - old.tx) / seconds : null
  }

  on cpu {
    let a = words(old)
    let b = words(value)
    // IRQ, soft IRQ and steal are busy; guest ticks are already included in user and nice.
    let busy = num(b[1]) + num(b[2]) + num(b[3]) + num(b[6]) + num(b[7]) + num(b[8]) -
               num(a[1]) - num(a[2]) - num(a[3]) - num(a[6]) - num(a[7]) - num(a[8])
    let idle = num(b[4]) + num(b[5]) - num(a[4]) - num(a[5])
    usage = a[0] == "cpu" && b[0] == "cpu" && busy >= 0 && idle >= 0 && busy + idle > 0 ? 100 * busy / (busy + idle) : null
  }

  let ram = system.memory.total > 0 ? 100 * system.memory.used / system.memory.total : null
  let watts = power.watts == null ? null : abs(power.watts)
  let hasDegrees = thermal.cpuC != null
  let powerLabel = power.watts == null || power.watts == 0 ? str.power : power.watts < 0 ? str.draw : str.charge
  let cpuRead = !linux || usage == null ? "—" : "${round(usage)}%"
  let ramRead = ram == null ? "—" : "${round(ram)}%"
  let downRead = down == null ? "—" : fmtBytes(down) + "/s"
  let upRead = up == null ? "—" : fmtBytes(up) + "/s"
  let tempRead = hasDegrees ? fixed(thermal.cpuC, 1) + "°" : str.stages[thermal.status] ?? "—"
  let powerRead = watts == null ? "—" : fixed(watts, 1) + " W"
  let cap = 120
  on clockSample first {
    // One snapshot per clock tick, independent of the order in which sources complete.
    samples = samples.drop(max(0, len(samples) + 1 - cap)) + [[linux ? usage : null, ram, down, up, thermal.cpuC, watts, thermal.status]]
  }
  let batteryTime = max(batteryClock ?? 0, last(chargeHistory)[0] ?? 0)
  let sinceCharge = batteryTime - 10800
  let cpuHistory = samples.map(s => s[0])
  let ramHistory = samples.map(s => s[1])
  let netHistory = samples.filter(s => s[2] != null && s[3] != null)
  let downHistory = netHistory.map(s => s[2])
  let upHistory = netHistory.map(s => s[3])
  let netMax = max(1, (max(downHistory + upHistory) ?? 0) * 1.15)
  let tempHistory = samples.map(s => s[4])
  let heatHistory = samples.map(s => s[6])
  let chargeInWindow = chargeHistory.filter(p => p[0] >= sinceCharge)
  let batteryDelta = len(chargeInWindow) < 2 ? null : last(chargeInWindow)[1] - first(chargeInWindow)[1]
  let powerHistory = samples.map(s => s[5])
  let dense = (tileWidth ?? 250) < 195 || (tileHeight ?? 240) < 200
  let gapSize = dense ? 3 : 5

  component Metric(label, reading, points, floor, ceiling, tint) {
    Column {
      weight: 1
      fill: height
      gap: 1
      padding: dense ? 3 : 5
      background: linear(0, 0, 0, 1, [alpha(surface, 0.80), alpha(background, 0.80)])
      border: 1
      borderColor: alpha(tint, 0.32)
      radius: 4 * corners
      clip: true

      Row {
        gap: 3
        align: center
        Text { text: label; color: muted; weight: 1; fontSize: dense ? 9 : 11; maxLines: 1 }
        Text { text: reading; color: tint; bold: true; fontSize: dense ? 10 : 13; maxLines: 1 }
      }

      Box {
        fill: width
        weight: 1
        Canvas {
          for i in range(3) {
            let y = (i + 1) * height / 4
            line(0, y, width, y, stroke: alpha(tint, 0.16))
          }
        }
        Sparkline { values: points; min: floor; max: ceiling; color: tint; area: alpha(tint, 0.18); thickness: 1.4; fill: true }
      }
    }
  }

  component Network(detail) {
    Column {
      weight: 1
      fill: detail ? "width" : "height"
      gap: 2
      padding: detail ? 10 : dense ? 3 : 5
      background: alpha(surface, 0.75)
      border: 1
      borderColor: alpha(cyan, 0.32)
      radius: 4 * corners
      clip: true
      if detail {
        Text { text: str.network; style: label }
      }
      Row {
        gap: 3
        Text { text: "↓ " + downRead; color: cyan; weight: 1; fontSize: detail ? 14 : dense ? 9 : 10; maxLines: 1 }
        Text { text: "↑ " + upRead; color: blue; weight: 1; fontSize: detail ? 14 : dense ? 9 : 10; align: end; maxLines: 1 }
      }
      Box {
        fill: width
        weight: detail ? 0 : 1
        height: detail ? 110 : null
        Sparkline { values: downHistory; min: 0; max: netMax; color: cyan; thickness: 1.4; fill: true }
        Sparkline { values: upHistory; min: 0; max: netMax; color: blue; thickness: 1.4; fill: true }
      }
    }
  }

  component BatteryHistory(detail) {
    let tint = battery.charging ? green : accent
    Column {
      weight: 1
      fill: detail ? "width" : "height"
      gap: 2
      padding: detail ? 10 : dense ? 3 : 5
      background: alpha(surface, 0.75)
      border: 1
      borderColor: alpha(tint, 0.32)
      radius: 4 * corners
      clip: true
      Row {
        align: center
        gap: 5
        Canvas {
          width: 19
          height: 11
          rect(0.5, 1, 15, 9, stroke: tint, width: 1, radius: 1.5)
          rect(16, 3.5, 2, 4, fill: tint, radius: 0.5)
          if battery.level > 0 {
            rect(2, 2.5, 12 * battery.level / 100, 6, fill: tint, radius: 0.6)
          }
        }
        if detail {
          Text { text: str.batteryWindow; style: label; weight: 1; maxLines: 1 }
        } else {
          Spacer { weight: 1 }
        }
        Text { text: battery == null ? "—" : "${battery.level}%"; color: tint; bold: true; fontSize: detail ? 16 : dense ? 10 : 13; maxLines: 1 }
      }
      Canvas {
        fill: width
        weight: detail ? 0 : 1
        height: detail ? 130 : null
        for i in range(3) {
          let y = (i + 1) * height / 4
          line(0, y, width, y, stroke: alpha(muted, 0.23))
        }
        for i in range(len(chargeHistory)) {
          let p = chargeHistory[i]
          let previous = i > 0 ? chargeHistory[i - 1] : null
          let x = 2 + (width - 4) * (p[0] - sinceCharge) / 10800
          let y = 2 + (height - 4) * (1 - p[1] / 100)
          let strokeColor = p[2] ? green : accent
          if previous != null && !p[3] && p[0] >= sinceCharge {
            let previousX = 2 + (width - 4) * max(0, previous[0] - sinceCharge) / 10800
            let previousY = 2 + (height - 4) * (1 - previous[1] / 100)
            line(previousX, previousY, x, y, stroke: strokeColor, width: 1.5, cap: round)
          } else if p[0] >= sinceCharge {
            circle(x, y, 1.4, fill: strokeColor)
          }
        }
      }
      if detail {
        Canvas {
          fill: width
          height: 14
          text(str.hours, 0, height / 2, size: 11, align: start, color: muted)
          text(str.twoHours, width / 3, height / 2, size: 11, align: center, color: muted)
          text(str.oneHour, width * 2 / 3, height / 2, size: 11, align: center, color: muted)
          text(str.now, width, height / 2, size: 11, align: end, color: muted)
        }
      } else {
        Row {
          gap: 3
          Text { text: str.hours; weight: 1; color: muted; fontSize: 9; maxLines: 1 }
          Text { text: str.now; color: muted; fontSize: 9; maxLines: 1 }
        }
      }
      if detail {
        Row {
          Text { text: battery.charging ? str.charge : str.draw; color: tint; weight: 1; style: small }
          Text { text: batteryDelta == null ? str.batteryWaiting : (batteryDelta > 0 ? "+" : "") + batteryDelta + " " + str.percentagePoints; color: muted; style: small }
        }
        if len(chargeInWindow) > 0 {
          let levels = chargeInWindow.map(p => p[1])
          Text { text: str.range + " " + min(levels) + "–" + max(levels) + "%"; color: muted; style: small }
        }
      }
    }
  }

  Column {
    fill: true
    gap: gapSize
    Row {
      fill: width
      weight: 1
      gap: gapSize
      Metric { label: "CPU"; reading: cpuRead; points: cpuHistory; floor: 0; ceiling: 100; tint: accent }
      Metric { label: str.memory; reading: ramRead; points: ramHistory; floor: 0; ceiling: 100; tint: purple }
    }
    Row {
      fill: width
      weight: 1
      gap: gapSize
      Network { detail: false }
      BatteryHistory { detail: false }
    }
    Row {
      fill: width
      weight: 1
      gap: gapSize
      Metric { label: hasDegrees ? str.temp : str.heat; reading: tempRead; points: hasDegrees ? tempHistory : heatHistory; floor: hasDegrees ? 20 : 0; ceiling: hasDegrees ? 100 : 6; tint: orange }
      Metric { label: powerLabel; reading: powerRead; points: powerHistory; floor: 0; ceiling: null; tint: green }
    }
  }

  component Chart(label, reading, points, floor, ceiling, tint, suffix, note) {
    let valid = points.filter(v => v != null)
    let low = len(valid) == 0 ? null : min(valid)
    let high = len(valid) == 0 ? null : max(valid)
    let average = len(valid) == 0 ? null : avg(valid)
    Column {
      gap: 6
      padding: 10
      background: alpha(surface, 0.65)
      border: 1
      borderColor: alpha(tint, 0.35)
      Row {
        gap: 8
        Text { text: label; weight: 1; style: label; maxLines: 1 }
        Text { text: reading; color: tint; style: title; maxLines: 1 }
      }
      if len(valid) > 0 {
        Sparkline { values: points; min: floor; max: ceiling; color: tint; area: alpha(tint, 0.22); thickness: 2; fill: width; height: 90 }
        Text { text: str.range + " " + fixed(low, 1) + "–" + fixed(high, 1) + suffix + "  ·  " + str.mean + " " + fixed(average, 1) + suffix; style: small; color: muted }
      }
      if note != "" {
        Text { text: note; style: small; color: muted }
      }
    }
  }

  screen {
    title: str.title
    Column {
      gap: 8
      scroll: true
      BatteryHistory { detail: true }
      Text { text: str.samples(len(samples)); style: small; color: muted }
      Chart { label: "CPU"; reading: cpuRead; points: cpuHistory; floor: 0; ceiling: 100; tint: accent; suffix: "%"; note: linux ? str.cpuScope : str.noCpu }
      Chart { label: str.memory; reading: ramRead; points: ramHistory; floor: 0; ceiling: 100; tint: purple; suffix: "%"; note: system.memory.total > 0 ? fmtBytes(system.memory.used) + " / " + fmtBytes(system.memory.total) : "" }
      Network { detail: true }
      if hasDegrees {
        Chart { label: str.temp; reading: tempRead; points: tempHistory; floor: 20; ceiling: 100; tint: orange; suffix: " °C"; note: "" }
      } else {
        Column {
          gap: 5
          padding: 10
          background: alpha(surface, 0.65)
          Text { text: str.heat + " · " + tempRead; style: label }
          Sparkline { values: heatHistory; min: 0; max: 6; color: orange; fill: width; height: 60 }
          Text { text: str.noTemp; style: small; color: muted }
        }
      }
      Chart { label: powerLabel; reading: powerRead; points: powerHistory; floor: 0; ceiling: null; tint: green; suffix: " W"; note: str.wattsNote }
      Button { text: str.files; onTap: launcher("widgets") }
    }
  }
}
