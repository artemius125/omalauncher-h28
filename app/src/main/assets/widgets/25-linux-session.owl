widget "linux-session" {
  page: 1
  order: 4
  size: 1x1
  minSize: 1x1
  meta { owl: 28; description: "Start or stop the Linux session." }

  onTap: launcher("linux:session")

  Canvas {
    fill: true
    let x = width / 2
    let y = height / 2
    let r = min(14, min(width, height) * 0.22)
    let status = linux ? green : red
    arc(x, y, r, 42, 276, stroke: foreground, width: 2.5, cap: round)
    line(x, y - r * 1.16, x, y - r * 0.14, stroke: foreground, width: 2.5, cap: round)
    circle(width - 6, 6, 6, fill: alpha(status, 0.12))
    circle(width - 6, 6, 4, fill: alpha(status, 0.27))
    circle(width - 6, 6, 2.5, fill: status)
  }
}
